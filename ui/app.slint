// SPDX-License-Identifier: MIT OR Apache-2.0
// ui/app.slint — TLToolBox「桌面实用工具箱」单栏界面（自双栏重构回归纯工具开关）。
//
// 语法目标：Slint 1.9 语言规范（兼容至本仓库 Cargo.lock 锁定的 1.17.x；改动须保持
// 双向可编译：不引入 1.9 之后新增的语法，也不使用已被后续版本弃用的旧 API）。
//
// 布局总览（480 × 560 适中单栏小窗体 · 深色专业风）
// ┌────────────────────────────────────────────────────────┐
// │ TLToolBox  [ v0.3.x ]         全部停用   全部启用        │ ← 顶部系统与全局控制栏
// │ 原生 Windows 轻量工具箱 · 桌面常驻 [关于][设置] 开机自启 [开关]│    标题/小版本号/自启/一键全开全关
// ├────────────────────────────────────────────────────────┤
// │  ┌ 模块名（加粗白字）        ●运行中/○已停止 [⚙][开关] ┐ │ ← ScrollView 流式卡片列表
// │  │ 详细用途描述（淡灰细字）                          │ │    有设置项的卡片在开关左侧
// │  └───────────────────────────────────────────────────┘ │    显示齿轮入口（轻量按钮）
// │  （……更多模块卡片，超出自动滚动……）                       │
// ├────────────────────────────────────────────────────────┤
// │  （规则 / 存储管理 / 主设置 / 关于 遮罩层：点击齿轮淡入；半透明遮罩 + 居中弹窗）│ ← 根层级 Overlay
// └────────────────────────────────────────────────────────┘
//
// 数据契约（供 Rust 侧 include_modules! 后经 VecModel 填充）：
//   - modules:            ModuleItem 列表（id/name/desc/enabled/has_settings）
//   - popup_rules:        弹窗拦截黑名单关键词（规则弹窗的列表数据源）
//   - captures:           弹窗拦截留痕记录（CaptureItem：文件名/标题/时间/路径）
//   - capture_preview:    留痕预览图（Rust 侧经 slint::Image::load_from_path 注入）
//   - capture_preview_caption: 预览图下方信息（文件名 + 标题）
//   - show_rules_modal:   「规则管理」弹窗展示开关（由 Rust 装配层驱动）
//   - terminal_log_dir_display / app_log_dir_display / screenshot_dir_display:
//                         三类路径的当前生效绝对路径（主设置 / 模块设置弹窗展示）
//   - show_terminal_modal:「终端日志记录 - 存储管理」弹窗展示开关（由 Rust 驱动）
//   - show_settings_modal:「全局设置（日志 / 截图目录自定义）」弹窗展示开关
//   - show_about_modal:   「关于 TLToolBox」弹窗展示开关
//   - update_status / update_available / latest_version: 检查更新状态文本与升级入口
//   - autostart_enabled:  全局开机自启当前生效状态（注册表为准）
//   - elevated:           提权（管理员）状态（启动装配层注入）：true = 标题旁渲染
//                         「管理员 (Admin)」翡翠徽标并隐藏提权入口；false = 渲染醒目
//                         盾牌提权按钮（突破 UIPI 拦截限制的入口）
//   - app-version:        界面小版本号（由 Rust 装配层经 env!("CARGO_PKG_VERSION")
//                         动态注入，UI 侧不写死任何版本号）
//   - toast_message:      Toast 提示文案（Rust 侧统一 show_toast 写入）
//   - show_toast:         Toast 显示开关（置 true 弹入，2.5s 后自动收回 / 点击胶囊即提前关闭）
// 回调契约：
//   - toggle_module(id, enabled)      ← 模块卡片 Switch 拨动
//   - toggle_autostart(enabled)       ← 全局「开机自启」Switch 拨动
//   - toggle_all_modules(enabled)     ← 「全部启用 / 全部停用」按钮点击
//   - request_elevate()               ← 盾牌提权按钮点击（Rust 侧经 UAC 确认后以管理员
//                                       身份重启，见 crate::platform::restart_as_admin）
//   - open_module_settings(module_id) ← 模块卡片齿轮点击（Rust 按模块 ID 分派：弹窗
//                                       拦截=「规则管理 + 留痕」弹窗；终端交互日志=
//                                       「存储管理」弹窗，见 TerminalSettingsModal）
//   - open_terminal_modal() / close_terminal_modal() ← 「存储管理」弹窗开关
//   - open_log_dir_in_explorer()      ← 「存储管理」弹窗：资源管理器打开日志目录
//   - browse_setting_dir(key)         ← 主设置 / 模块设置：Win32 原生文件夹选择切换路径
//                                       （key: "app_log" | "terminal_log" | "popup_screenshot"）
//   - open_setting_dir(key)           ← 主设置：资源管理器打开指定目录
//   - reset_setting_dir(key)          ← 主设置 / 模块设置：恢复默认目录（None）
//   - open_about_modal() / close_about_modal()  ← 「关于」弹窗开关
//   - open_repo_url()                 ← 「关于」：系统浏览器打开开源地址
//   - check_for_updates()             ← 「关于」：WinHttp 原生检查 GitHub 最新发行版
//   - open_download_url()             ← 「关于」：发现新版本后打开下载页
//   - capture_selected(index)         ← 留痕列表选中：Rust 加载预览图
//   - open_capture_dir()              ← 留痕区：资源管理器打开截图目录
//   - close_rules_modal()             ← 弹窗「×」/ 遮罩空白点击
//   - add_rule(keyword)               ← 弹窗底部「添加」（含输入框回车）
//   - remove_rule(index)              ← 规则行右侧红色删除按钮
//   - trigger_toast(string)           （预留）UI 内任意元素请求 Toast（Rust 侧与 show_toast 同入口）
//
// 注：随双栏日志控制台退役，LogEntry 已从本文件移除；运行日志改由 tracing 承载。

import { Switch, ScrollView, VerticalBox, HorizontalBox, LineEdit } from "std-widgets.slint";

// —— 模块列表条目：与调度层 ModuleMeta 一一对应 ——
export struct ModuleItem {
    id: string,
    name: string,
    desc: string,
    enabled: bool,
    // 是否有「设置面板」：为真时卡片在 Switch 左侧渲染齿轮按钮
    // （当前为弹窗拦截：规则管理 + 留痕弹窗；终端交互日志：存储管理弹窗，见 Rust 侧分派）。
    has_settings: bool,
}

// —— 弹窗拦截留痕列表条目（与 popup_blocker::CaptureRecord 对应） ——
export struct CaptureItem {
    // 截图文件名（popup_<时间>_<序号>.png）
    file_name: string,
    // 被拦截窗口标题
    title: string,
    // 拦截时刻（本地时间文本）
    captured_at: string,
    // 截图文件绝对路径（Rust 侧选中时按此加载预览）
    path: string,
}

// —— 全局窗口置顶候选窗口行（与 topmost_manager 的枚举 + 置顶状态合并） ——
export struct TopmostWindowItem {
    // 窗口句柄十六进制简报（0x…，同时作为操作回路的稳定键）
    hwnd: string,
    // 所属进程可执行文件名（notepad.exe）
    process_name: string,
    // 窗口标题（截断显示）
    title: string,
    // 系统当前是否带 WS_EX_TOPMOST（只读指示，随刷新收敛）
    topmost: bool,
    // 当前优先级（1~9，1 最顶层；由 Rust 夹紧后回写）
    priority: int,
    // 是否受本模块管理（= 当前置顶中，驱动 Switch 与步进器）
    pinned: bool,
}

// —— 全局设置目录行的键（与 Rust 侧 browse/reset/open 分派一致） ——
export enum PathKind {
    app-log,
    terminal-log,
    popup-screenshot,
}

// —— 全局暗色主题令牌（zinc 底 + 翡翠强调；统一取色，避免魔法数字散落） ——
export global Theme {
    in-out property <color> window-bg: #18181b;       // 窗口底
    in-out property <color> card-bg: #27272a;         // 卡片底
    in-out property <color> card-bg-hover: #2e2e33;   // 卡片悬停底
    in-out property <color> card-border: #34343a;     // 卡片描边
    in-out property <color> card-border-hover: #4c4c55;
    in-out property <color> divider: #26262b;         // 顶栏分隔线
    in-out property <color> text-strong: #ffffff;     // 标题 / 模块名
    in-out property <color> text-primary: #e4e4e7;    // 一般正文
    in-out property <color> text-secondary: #a1a1aa;  // 描述
    in-out property <color> text-muted: #71717a;      // 弱化辅助文字
    in-out property <color> accent-strong: #34d399;   // 强调（运行态文字）
    in-out property <color> running-dot: #4ade80;     // 运行中绿点
    in-out property <color> stopped-dot: #52525b;     // 已停止灰点
    in-out property <color> pill-bg: #10b9811a;       // 版本徽标底
    in-out property <color> pill-border: #10b98140;
    in-out property <color> pill-text: #6ee7b7;
    in-out property <color> btn-bg: #1d1d21;          // 轻量按钮底
    in-out property <color> btn-bg-hover: #26262b;
    in-out property <color> btn-bg-pressed: #323238;
    in-out property <color> btn-border: #3f3f46;
    in-out property <color> btn-border-hover: #62626b;

    // —— 管理员徽标 / 提权盾牌按钮（UIPI 突围入口）专用令牌 ——
    in-out property <color> admin-badge-bg: #10b98121;        // 管理员徽标底（翡翠淡底）
    in-out property <color> admin-badge-border: #10b98159;    // 管理员徽标描边
    in-out property <color> admin-badge-text: #6ee7b7;        // 管理员徽标文字（翡翠色）
    in-out property <color> elevate-bg: #f59e0b1f;            // 盾牌按钮底（琥珀淡底，醒目）
    in-out property <color> elevate-bg-hover: #f59e0b38;
    in-out property <color> elevate-bg-pressed: #f59e0b52;
    in-out property <color> elevate-border: #f59e0b80;
    in-out property <color> elevate-border-hover: #fbbf24b3;
    in-out property <color> elevate-icon: #fbbf24;            // 盾牌图形着色（琥珀金）

    // —— 规则管理弹窗专用令牌 ——
    in-out property <color> overlay-scrim: #0b0b0ecc;    // 遮罩半透明黑
    in-out property <color> dialog-bg: #202024;          // 弹窗卡片底
    in-out property <color> dialog-border: #3f3f46;      // 弹窗卡片描边
    in-out property <color> row-bg-hover: #2b2b30;       // 规则行悬停底
    in-out property <color> danger: #f87171;             // 删除红
    in-out property <color> danger-hover-bg: #f8717126;
    in-out property <color> danger-pressed-bg: #f8717140;
    in-out property <color> accent-bg: #10b981;          // 「添加」实底按钮
    in-out property <color> accent-bg-hover: #34d399;
    in-out property <color> accent-bg-pressed: #059669;
    in-out property <color> accent-fg: #06281a;          // 实底按钮上的文字
    in-out property <color> accent-bg-disabled: #10b98133;
    in-out property <color> accent-fg-disabled: #a1a1aa;

    // —— Toast 轻量操作反馈专用令牌 ——
    in-out property <color> toast-bg: #27272ae6;    // 胶囊底：zinc-800(#27272a) 派生，~90% 不透明（浮于内容上轻微透底）
    in-out property <color> toast-border: #3f3f46;  // 胶囊细描边
    in-out property <color> toast-text: #ffffff;    // 胶囊正文（纯白）

    // —— 关于 / 设置 / 留痕区专用令牌 ——
    in-out property <color> link-text: #6ee7b7;          // 可点击链接文字（翡翠）
    in-out property <color> link-bg-hover: #10b98126;    // 链接悬停底
    in-out property <color> update-badge-bg: #fbbf2426;  // “发现新版本”徽标底（琥珀淡底）
    in-out property <color> update-badge-border: #fbbf2480;
    in-out property <color> update-badge-text: #fcd34d;  // 琥珀强调文字
}

// —— 轻量操作按钮：全部启用 / 全部停用 / 关于 / 设置（幽灵样式，低打扰） ——
component GhostButton inherits Rectangle {
    in property <string> text: "";
    in property <length> button-width: 76px;
    callback clicked;

    width: root.button-width;
    height: 26px;
    border-radius: 7px;
    border-width: 1px;
    background: Theme.btn-bg;
    border-color: Theme.btn-border;

    states [
        hover when ghost-touch.has-hover && !ghost-touch.pressed : {
            background: Theme.btn-bg-hover;
            border-color: Theme.btn-border-hover;
        }
        pressed when ghost-touch.pressed : {
            background: Theme.btn-bg-pressed;
            border-color: Theme.btn-border-hover;
        }
    ]
    animate background, border-color { duration: 100ms; }

    Text {
        text: root.text;
        font-size: 12px;
        font-weight: 600;
        color: Theme.text-primary;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ghost-touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

// —— 提权盾牌按钮：标题旁的醒目提权入口（仅未提权形态渲染） ——
// 琥珀金描边 + 淡琥珀底，与全界面锌灰/翡翠基调刻意区分——它在视觉上宣告
// “当前运行权限受限，点击可一键提权重启以突破 UIPI 弹窗拦截限制”。
component ElevateButton inherits Rectangle {
    callback clicked;

    width: 28px;
    height: 26px;
    border-radius: 8px;
    background: Theme.elevate-bg;
    border-width: 1px;
    border-color: Theme.elevate-border;

    states [
        hover when elevate-touch.has-hover && !elevate-touch.pressed : {
            background: Theme.elevate-bg-hover;
            border-color: Theme.elevate-border-hover;
        }
        pressed when elevate-touch.pressed : {
            background: Theme.elevate-bg-pressed;
            border-color: Theme.elevate-border-hover;
        }
    ]
    animate background, border-color { duration: 100ms; }

    Image {
        source: @image-url("icons/shield.svg");
        colorize: Theme.elevate-icon;
        width: 15px;
        height: 15px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    elevate-touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

// —— 管理员徽标：标题 / 版本旁的翡翠色小徽标（仅已提权形态渲染） ——
// 与版本号徽标同高同族的“翡翠胶囊”；存在即向用户确认“当前实例已以管理员权限
// 运行，弹窗拦截已突破 UIPI 限制”，同时提权按钮 / 托盘提权菜单随之隐藏。
component AdminBadge inherits Rectangle {
    width: 104px;
    height: 20px;
    border-radius: 10px;
    background: Theme.admin-badge-bg;
    border-width: 1px;
    border-color: Theme.admin-badge-border;

    Text {
        text: "管理员 (Admin)";
        font-size: 10px;
        font-weight: 600;
        color: Theme.admin-badge-text;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// —— 轻量图标按钮：模块齿轮入口 / 弹窗右上角关闭（透明底 + 悬停微亮） ——
component GhostIconButton inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color: Theme.text-secondary;
    in property <length> icon-size: 15px;
    callback clicked;

    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: transparent;

    states [
        hover when icon-touch.has-hover && !icon-touch.pressed : {
            background: Theme.btn-bg-hover;
        }
        pressed when icon-touch.pressed : {
            background: Theme.btn-bg-pressed;
        }
    ]
    animate background { duration: 100ms; }

    Image {
        source: root.icon;
        colorize: root.icon-color;
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    icon-touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

// —— 实底主按钮：「添加」规则（空输入时禁用态） ——
component PrimaryButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> enabled: true;
    callback clicked;

    width: 92px;
    height: 32px;
    border-radius: 8px;
    background: Theme.accent-bg;

    states [
        disabled when !root.enabled : {
            background: Theme.accent-bg-disabled;
        }
        hover when root.enabled && touch.has-hover && !touch.pressed : {
            background: Theme.accent-bg-hover;
        }
        pressed when root.enabled && touch.pressed : {
            background: Theme.accent-bg-pressed;
        }
    ]
    animate background { duration: 100ms; }

    Text {
        text: root.text;
        font-size: 12px;
        font-weight: 700;
        color: root.enabled ? Theme.accent-fg : Theme.accent-fg-disabled;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// —— 模块卡片：名称 / 描述 / 状态徽标 / 设置齿轮（可选）/ 物理开关 ——
component ModuleCard inherits Rectangle {
    in property <ModuleItem> module;
    callback toggled(bool);
    callback settings-clicked;

    height: 62px;
    background: Theme.card-bg;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;

    states [
        hover when card-hover.has-hover : {
            background: Theme.card-bg-hover;
            border-color: Theme.card-border-hover;
        }
    ]
    animate background, border-color { duration: 120ms; }

    // 悬停感应层置于最底层：不拦截上层 Switch / 齿轮 / 文本区域的点击。
    card-hover := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }

    HorizontalBox {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 12px;

        // 名称（加粗白字）+ 描述（淡灰细字）：宽度弹性吸收，保证右侧控件恒靠右
        VerticalBox {
            spacing: 3px;
            horizontal-stretch: 1;
            alignment: center; // 主轴（纵向）居中：文本块在 62px 卡片内垂直居中

            Text {
                text: root.module.name;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text-strong;
                overflow: elide;
                min-height: 19px;
                vertical-alignment: center;
            }
            Text {
                text: root.module.desc;
                font-size: 10.5px;
                color: Theme.text-secondary;
                overflow: elide;
                min-height: 15px;
                vertical-alignment: center;
            }
        }

        // 右侧控件组（固定列宽规范，保证 5 张卡片右侧横平竖直严格对齐）：
        //   状态指示区 72px → 设置齿轮插槽 28px → 物理开关（40 × 20 固定）。
        // 行本身不设 alignment；三列宽度恒定为显式值，无论卡片有无设置弹窗，
        // 状态文本 / 开关的横纵位置都绝对一致——无齿轮的卡片渲染等宽透明占位。
        HorizontalBox {
            spacing: 8px;

            // 状态指示区：72px 固定列宽；圆点 + 状态文本贴齐列右缘、垂直居中
            Rectangle {
                width: 72px;
                height: parent.height;

                HorizontalBox {
                    width: parent.width;
                    spacing: 6px;
                    alignment: end;
                    y: (parent.height - self.height) / 2;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: root.module.enabled ? Theme.running-dot : Theme.stopped-dot;
                    }
                    Text {
                        text: root.module.enabled ? "运行中" : "已停止";
                        font-size: 10px;
                        color: root.module.enabled ? Theme.accent-strong : Theme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            // 设置齿轮插槽：28px 固定列宽。有设置弹窗的卡片渲染齿轮按钮（24 × 24
            // 于列内居中）；无设置弹窗的卡片渲染同尺寸透明占位，状态指示区与
            // 开关列因此绝不左右漂移。
            Rectangle {
                width: 28px;
                height: parent.height;

                if root.module.has_settings : GhostIconButton {
                    icon: @image-url("icons/settings.svg");
                    icon-size: 14px;
                    icon-color: Theme.text-secondary;
                    width: 24px;
                    height: 24px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.settings-clicked(); }
                }
                if !root.module.has_settings : Rectangle {
                    width: 24px;
                    height: 24px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: transparent;
                }
            }

            // 开关区：40 × 20 固定宽高（列内垂直居中，与状态 / 齿轮两列同位对齐）
            Rectangle {
                width: 40px;
                height: parent.height;

                // 硬开关：状态以 modules 模型为唯一真源；点击即上报回调，底层落定
                // 后的权威状态（含失败回滚）由 Rust 经事件总线刷新模型驱动绑定收敛。
                Switch {
                    width: 40px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    checked: root.module.enabled;
                    toggled => {
                        root.toggled(self.checked);
                    }
                }
            }
        }
    }
}

// —— 规则行：关键词文本 + 行尾红色删除按钮（悬停整行微亮） ——
component RuleRow inherits Rectangle {
    in property <string> rule;
    callback remove-requested;

    height: 36px;
    border-radius: 8px;
    background: transparent;

    states [
        hover when row-hover.has-hover : {
            background: Theme.row-bg-hover;
        }
    ]
    animate background { duration: 90ms; }

    // 悬停感应层（置于内容之下，不拦截删除按钮的点击）。
    row-hover := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }

    HorizontalBox {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;
        alignment: center;

        Text {
            text: root.rule;
            font-size: 12px;
            color: Theme.text-primary;
            overflow: elide;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        // 删除按钮：常态即红色警示（与整行悬停区分）；点击上抛行号由装配层删除。
        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 6px;
            background: transparent;

            states [
                hover when del-touch.has-hover && !del-touch.pressed : {
                    background: Theme.danger-hover-bg;
                }
                pressed when del-touch.pressed : {
                    background: Theme.danger-pressed-bg;
                }
            ]
            animate background { duration: 90ms; }

            Image {
                source: @image-url("icons/trash.svg");
                colorize: Theme.danger;
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
            del-touch := TouchArea {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                clicked => { root.remove-requested(); }
            }
        }
    }
}

// —— 通用文本按钮：幽灵底 / 实底强调两态（存储管理、全局设置、关于弹窗复用） ——
component TextButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> primary: false;
    in property <length> button-width: 84px;
    in property <length> button-height: 30px;
    callback clicked;

    width: root.button-width;
    height: root.button-height;
    border-radius: 7px;
    background: root.primary ? Theme.accent-bg : Theme.btn-bg;
    border-width: 1px;
    border-color: root.primary ? Theme.accent-bg : Theme.btn-border;

    states [
        hover when btn-touch.has-hover && !btn-touch.pressed : {
            background: root.primary ? Theme.accent-bg-hover : Theme.btn-bg-hover;
            border-color: root.primary ? Theme.accent-bg-hover : Theme.btn-border-hover;
        }
        pressed when btn-touch.pressed : {
            background: root.primary ? Theme.accent-bg-pressed : Theme.btn-bg-pressed;
            border-color: root.primary ? Theme.accent-bg-pressed : Theme.btn-border-hover;
        }
    ]
    animate background, border-color { duration: 100ms; }

    Text {
        text: root.text;
        font-size: 11.5px;
        font-weight: 600;
        color: root.primary ? Theme.accent-fg : Theme.text-primary;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    btn-touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

// —— 弹窗拦截留痕行：文件名 / 标题 / 时间（点击选中预览） ——
component CaptureRow inherits Rectangle {
    in property <CaptureItem> capture;
    callback clicked;

    height: 46px;
    border-radius: 8px;
    background: transparent;

    states [
        hover when cap-hover.has-hover : {
            background: Theme.row-bg-hover;
        }
    ]
    animate background { duration: 90ms; }

    cap-hover := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }

    VerticalBox {
        padding-left: 10px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 2px;
        alignment: center;

        Text {
            text: root.capture.file_name;
            font-size: 10.5px;
            font-weight: 600;
            color: Theme.text-primary;
            overflow: elide;
        }
        Text {
            text: root.capture.title;
            font-size: 10px;
            color: Theme.text-muted;
            overflow: elide;
        }
        Text {
            text: root.capture.captured_at;
            font-size: 9px;
            color: Theme.text-muted;
        }
    }
}

// —— 全局设置目录行：标题 + 当前路径 + 更改 / 打开 / 恢复默认 ——
component PathSettingRow inherits Rectangle {
    in property <string> title: "";
    in property <string> tip: "";
    in property <string> path: "";
    in property <string> key: "";
    callback browse-key(string);
    callback open-key(string);
    callback reset-key(string);

    // 高度由内容自然撑开：不设固定 height——标题行 / 路径行 / 按钮行 + 内边距
    // 共同决定卡片高度，杜绝「更改 / 打开 / 恢复默认」按钮溢出卡片底边（v0.3.2 布局修复）。
    border-radius: 10px;
    background: Theme.card-bg;
    border-width: 1px;
    border-color: Theme.card-border;

    VerticalBox {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 7px;

        // 标题行：名称 + 用途提示
        HorizontalBox {
            spacing: 8px;

            Text {
                text: root.title;
                font-size: 12px;
                font-weight: 600;
                color: Theme.text-strong;
                vertical-alignment: center;
            }
            Text {
                text: root.tip;
                font-size: 9.5px;
                color: Theme.text-muted;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
        }

        // 当前路径（单行省略展示）
        Text {
            text: root.path;
            font-size: 10px;
            color: Theme.text-secondary;
            overflow: elide;
            horizontal-stretch: 1;
        }

        // 操作行：更改（原生文件夹选择）/ 打开（资源管理器）/ 恢复默认（None）
        HorizontalBox {
            spacing: 8px;
            alignment: start;

            TextButton {
                text: "更改…";
                button-width: 72px;
                button-height: 24px;
                clicked => { root.browse-key(root.key); }
            }
            TextButton {
                text: "打开";
                button-width: 60px;
                button-height: 24px;
                clicked => { root.open-key(root.key); }
            }
            TextButton {
                text: "恢复默认";
                button-width: 76px;
                button-height: 24px;
                clicked => { root.reset-key(root.key); }
            }
        }
    }
}

// —— 弹窗拦截 · 黑名单规则管理 + 拦截留痕（根层级 Overlay：遮罩 + 居中弹窗卡片） ——
//
// 输入 / 动画架构（避免“隐藏弹层拦截主界面交互”）：
//   - 遮罩层常驻挂载、仅以 opacity 渐变进出：隐藏态其全部 TouchArea 经 enabled
//     关闭（Slint 语义：disabled 的 TouchArea 把事件原样穿透给下层元素），因此
//     纯视觉层不会形成点击 / 滚轮黑洞；
//   - 弹窗卡片（含 std-widgets ScrollView 的 Flickable 滚动逻辑）**只在展示期
//     挂载**（`if root.show`）：ScrollView 隐藏后即从树中移除，杜绝“隐藏态滚轮
//     仍被 Flickable 消费、主列表滚动失灵”的陷阱。代价是卡片无离场过渡——由
//     遮罩的淡出动画承接视觉收尾，整体观感干净利落。
component RulesModal inherits Rectangle {
    in property <bool> show;
    in property <[string]> rules;
    // —— v0.3.2 拦截留痕（截图列表 + 预览） ——
    in property <[CaptureItem]> captures;
    in property <image> capture-preview;
    in property <string> capture-preview-caption: "";
    callback close-requested;
    callback add-requested(string);
    callback remove-requested(int);
    callback capture-selected(int);
    callback open-capture-dir();
    callback browse-capture-dir();

    // 半透明遮罩底：透明度随 show 渐变（入场淡入 / 关闭淡出）。
    // 注意：本组件根元素的宽高在装配点（MainWindow）以窗口尺寸显式给出，
    // 组件自身不绑定 `parent`（组件根没有组件内父级可引用）。
    background: Theme.overlay-scrim;
    opacity: root.show ? 1.0 : 0.0;
    animate opacity { duration: 160ms; easing: ease-out; }

    // 遮罩点击层：点击弹窗之外的空白 → 请求关闭；同时吞没滚轮，
    // 防止滚轮穿透到被遮罩的主界面滚动列表。
    backdrop := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        enabled: root.show;
        clicked => { root.close-requested(); }
        scroll-event(event) => { return accept; }
    }

    // 居中弹窗卡片（仅展示期挂载，见组件文档的输入架构说明）。
    if root.show : dialog := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(460px, parent.width - 32px);
        height: min(560px, parent.height - 24px);
        border-radius: 14px;
        background: Theme.dialog-bg;
        border-width: 1px;
        border-color: Theme.dialog-border;
        clip: true;

        // 卡片空白区吞没层：防止点击 / 滚动穿透到遮罩层造成误关闭。
        body-catcher := TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            clicked => { }
            scroll-event(event) => { return accept; }
        }

        VerticalBox {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 12px;

            // —— 标题行：弹窗标题 + 关闭按钮 ——
            HorizontalBox {
                spacing: 8px;

                Text {
                    text: "桌面弹窗拦截 - 黑名单规则管理";
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.text-strong;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                GhostIconButton {
                    icon: @image-url("icons/close.svg");
                    icon-size: 13px;
                    icon-color: Theme.text-muted;
                    clicked => { root.close-requested(); }
                }
            }

            // —— 匹配语义提示 ——
            Text {
                text: "拦截窗口标题或类名包含关键词的弹窗（子串匹配 · 忽略大小写）；增删即时生效并自动保存。";
                font-size: 11px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }

            // 分隔线
            Rectangle {
                height: 1px;
                background: Theme.divider;
            }

            // —— 规则列表：纵向滚动（仅展示期挂载，避免隐藏态占用滚动事件） ——
            rules-scroll := ScrollView {
                vertical-stretch: 1;

                VerticalBox {
                    padding-right: 8px; // 预留纵向滚动条悬浮带
                    padding-top: 2px;
                    padding-bottom: 2px;
                    spacing: 4px;
                    width: rules-scroll.visible-width;

                    // 空列表引导态
                    if root.rules.length == 0 : Rectangle {
                        height: 150px;

                        Text {
                            text: "暂无规则\n在下方输入关键词并点击「添加」，建立第一条拦截规则";
                            font-size: 11px;
                            color: Theme.text-muted;
                            width: parent.width;
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    for rule[index] in root.rules : RuleRow {
                        rule: rule;
                        remove-requested => { root.remove-requested(index); }
                    }
                }
            }

            // 分隔线：规则区与拦截留痕区
            Rectangle {
                height: 1px;
                background: Theme.divider;
            }

            // —— 拦截留痕区：最近拦截的截图列表（左）+ 预览（右） ——
            // 每次拦截成功截图后，Rust 侧经版本号订阅刷新本列表；选中条目加载预览图。
            HorizontalBox {
                spacing: 8px;
                alignment: center;

                Text {
                    text: "最近拦截留痕";
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.text-strong;
                    vertical-alignment: center;
                }
                Text {
                    text: root.captures.length == 0 ? "暂无记录" : (root.captures.length + " 条");
                    font-size: 10px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }

                GhostButton {
                    text: "更改目录";
                    button-width: 72px;
                    height: 22px;
                    clicked => { root.browse-capture-dir(); }
                }
                GhostButton {
                    text: "打开目录";
                    button-width: 72px;
                    height: 22px;
                    clicked => { root.open-capture-dir(); }
                }
            }

            // 留痕区主体：左列表 + 右预览（高度固定 ~150px，列表内部滚动）
            Rectangle {
                height: 150px;

                HorizontalBox {
                    spacing: 10px;

                    // 左：留痕列表（纵向滚动）
                    captures-scroll := ScrollView {
                        width: 186px;

                        VerticalBox {
                            padding-right: 6px; // 预留滚动条悬浮带
                            spacing: 4px;
                            width: captures-scroll.visible-width;

                            if root.captures.length == 0 : Rectangle {
                                height: 90px;

                                Text {
                                    text: "暂无拦截留痕\n命中黑名单的弹窗被关闭后自动截图留存";
                                    font-size: 10px;
                                    color: Theme.text-muted;
                                    width: parent.width;
                                    height: parent.height;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            for capture[index] in root.captures : CaptureRow {
                                capture: capture;
                                clicked => { root.capture-selected(index); }
                            }
                        }
                    }

                    // 右：预览区（图片 contain 适配 + 底部信息条）
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 8px;
                        background: Theme.card-bg;
                        border-width: 1px;
                        border-color: Theme.card-border;
                        clip: true;

                        Image {
                            source: root.capture-preview;
                            image-fit: contain;
                            width: parent.width - 16px;
                            height: parent.height - 28px;
                            x: 8px;
                            y: 6px;
                        }
                        Text {
                            text: root.capture-preview-caption;
                            font-size: 9.5px;
                            color: Theme.text-muted;
                            overflow: elide;
                            width: parent.width - 10px;
                            x: 5px;
                            y: parent.height - 20px;
                            height: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // —— 底部：单行输入 + 添加按钮 ——
            HorizontalBox {
                spacing: 10px;
                alignment: center;

                input := LineEdit {
                    placeholder-text: "输入要拦截的窗口标题 / 类名关键词…";
                    font-size: 12px;
                    horizontal-stretch: 1;
                    accepted(text) => {
                        if (text != "") {
                            root.add-requested(text);
                            input.text = "";
                        }
                    }
                }
                PrimaryButton {
                    text: "添加";
                    enabled: input.text != "";
                    clicked => {
                        if (input.text != "") {
                            root.add-requested(input.text);
                            input.text = "";
                        }
                    }
                }
            }
        }
    }
}

// —— 终端交互日志 · 存储管理（根层级 Overlay 2：与 RulesModal 同构的遮罩 + 居中
//    弹窗卡片。展示当前生效的日志存储目录绝对路径，并提供「资源管理器打开」入口） ——
//
// 输入 / 动画架构与 RulesModal 完全一致（避免隐藏弹层拦截主界面交互）：
//   - 遮罩层常驻挂载、仅以 opacity 渐变进出：隐藏态其全部 TouchArea 经 enabled
//     关闭（Slint 语义：disabled 的 TouchArea 把事件原样穿透给下层元素），纯视觉层
//     不会形成点击 / 滚轮黑洞；
//   - 弹窗卡片**只在展示期挂载**（`if root.show`）：隐藏即从树中移除，离场视觉由
//     遮罩的淡出动画承接（与 RulesModal 同一取舍——本弹窗无滚动内容，无滚轮陷阱）。
component TerminalSettingsModal inherits Rectangle {
    in property <bool> show;
    in property <string> log-dir: "";
    callback close-requested;
    callback open-log-dir-requested;
    callback browse-dir-requested;
    callback reset-dir-requested;

    // 半透明遮罩底：透明度随 show 渐变（入场淡入 / 关闭淡出）。根元素宽高在装配点
    // （MainWindow）以窗口尺寸显式给出，组件自身不绑定 `parent`。
    background: Theme.overlay-scrim;
    opacity: root.show ? 1.0 : 0.0;
    animate opacity { duration: 160ms; easing: ease-out; }

    // 遮罩点击层：点击弹窗之外空白 → 请求关闭；同时吞没滚轮防止穿透主界面。
    backdrop := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        enabled: root.show;
        clicked => { root.close-requested(); }
        scroll-event(event) => { return accept; }
    }

    // 居中弹窗卡片（仅展示期挂载，见组件文档的输入架构说明）。
    if root.show : dialog := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(460px, parent.width - 32px);
        height: min(292px, parent.height - 48px);
        border-radius: 14px;
        background: Theme.dialog-bg;
        border-width: 1px;
        border-color: Theme.dialog-border;
        clip: true;

        // 卡片空白区吞没层：点击 / 滚动不穿透到遮罩层造成误关闭。
        body-catcher := TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            clicked => { }
            scroll-event(event) => { return accept; }
        }

        VerticalBox {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 10px;

            // —— 标题行：弹窗标题 + 关闭按钮 ——
            HorizontalBox {
                spacing: 8px;

                Text {
                    text: "终端日志记录 - 存储管理";
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.text-strong;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                GhostIconButton {
                    icon: @image-url("icons/close.svg");
                    icon-size: 13px;
                    icon-color: Theme.text-muted;
                    clicked => { root.close-requested(); }
                }
            }

            // —— 语义提示 ——
            Text {
                text: "会话日志按 Shell 类型（powershell / bash / cmd）写入该目录下的子文件夹。";
                font-size: 11px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }

            // —— 存储目录标签 ——
            Text {
                text: "当前存储目录：";
                font-size: 12px;
                color: Theme.text-secondary;
            }

            // —— 绝对路径展示框：单行展示，过长以省略号收尾 ——
            dir-box := Rectangle {
                height: 36px;
                border-radius: 8px;
                background: Theme.card-bg;
                border-width: 1px;
                border-color: Theme.card-border;

                Text {
                    text: root.log-dir;
                    font-size: 11px;
                    color: Theme.text-primary;
                    overflow: elide;
                    x: 12px;
                    y: 0;
                    width: parent.width - 24px;
                    height: parent.height;
                    vertical-alignment: center;
                }
            }

            // 弹性占位：把主操作按钮沉底（内容不足时吸收剩余纵向空间）。
            Rectangle { vertical-stretch: 1; }

            // —— 操作行：更改目录（原生文件夹选择）/ 恢复默认 / 资源管理器打开 ——
            HorizontalBox {
                spacing: 10px;
                alignment: center;

                TextButton {
                    text: "更改目录…";
                    button-width: 96px;
                    clicked => { root.browse-dir-requested(); }
                }
                TextButton {
                    text: "恢复默认";
                    button-width: 84px;
                    clicked => { root.reset-dir-requested(); }
                }
                TextButton {
                    text: "在资源管理器中打开";
                    button-width: 160px;
                    button-height: 34px;
                    primary: true;
                    clicked => { root.open-log-dir-requested(); }
                }
            }
        }
    }
}

// —— 优先级步进器：1~9 级数字调节（全局窗口置顶弹窗行内控件） ——
// 左侧「−」/ 右侧「+」两个轻量按钮夹中间数值；数值恒夹紧 1..=9。
// `enabled=false`（未置顶）时整组灰化且不响应点击。
component PriorityStepper inherits Rectangle {
    in property <int> value: 3;
    in property <bool> enabled: true;
    callback changed(int);

    // 固定 96 × 28：置顶弹窗行内中栏的钉死列宽（三栏对齐规范的一部分，见 TopmostWindowRow）。
    width: 96px;
    height: 28px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.enabled ? Theme.btn-border : #2e2e33;
    background: root.enabled ? Theme.btn-bg : #1c1c20;

    Rectangle {
        x: 0;
        y: 0;
        width: 28px;
        height: parent.height;
        border-radius: 8px;
        background: transparent;

        states [
            hover when minus-touch.has-hover && root.enabled && !minus-touch.pressed : {
                background: Theme.btn-bg-hover;
            }
            pressed when root.enabled && minus-touch.pressed : {
                background: Theme.btn-bg-pressed;
            }
        ]
        animate background { duration: 90ms; }

        Text {
            text: "−";
            font-size: 14px;
            font-weight: 700;
            color: root.enabled ? Theme.text-primary : Theme.text-muted;
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        minus-touch := TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            enabled: root.enabled;
            clicked => {
                root.changed(max(1, root.value - 1));
            }
        }
    }

    Text {
        x: 28px;
        width: parent.width - 56px;
        height: parent.height;
        text: root.value;
        font-size: 12px;
        font-weight: 700;
        color: root.enabled ? Theme.text-strong : Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        x: parent.width - 28px;
        y: 0;
        width: 28px;
        height: parent.height;
        border-radius: 8px;
        background: transparent;

        states [
            hover when plus-touch.has-hover && root.enabled && !plus-touch.pressed : {
                background: Theme.btn-bg-hover;
            }
            pressed when root.enabled && plus-touch.pressed : {
                background: Theme.btn-bg-pressed;
            }
        ]
        animate background { duration: 90ms; }

        Text {
            text: "+";
            font-size: 14px;
            font-weight: 700;
            color: root.enabled ? Theme.text-primary : Theme.text-muted;
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        plus-touch := TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            enabled: root.enabled;
            clicked => {
                root.changed(min(9, root.value + 1));
            }
        }
    }
}

// —— 全局窗口置顶弹窗的候选窗口行：纯文本（进程名 + 截断标题 + HWND 简报） ——
// 行内三栏固定列宽对齐规范：左栏·信息区（stretch 吸余、文本左对齐 + 省略）→
// 中栏·优先级步进器（96 × 28 固定）→ 右栏·置顶开关（44px 固定列宽、贴列右缘）。
// 行内不加载任何窗口图标（防爆显存）。
component TopmostWindowRow inherits Rectangle {
    in property <TopmostWindowItem> window;
    callback pin-toggled(bool);
    callback priority-changed(int);

    height: 52px;
    border-radius: 9px;
    background: transparent;

    states [
        hover when row-hover.has-hover : {
            background: Theme.row-bg-hover;
        }
    ]
    animate background { duration: 90ms; }

    // 悬停感应层置于内容之下，不拦截右侧控件点击。
    row-hover := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }

    // 三栏式布局（行本身不设 alignment，杜绝列位漂移）：
    //   左栏·信息区：horizontal-stretch 吸收剩余宽度，文本左对齐顶格 + overflow: elide；
    //   中栏·优先级步进器：96 × 28 固定，行内垂直居中；
    //   右栏·置顶开关：44px 固定列宽，开关整列贴右缘、垂直居中。
    HorizontalBox {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;

        // 左栏·信息区：进程名 + 截断标题 / HWND 简报（两行垂直居中、水平左对齐）
        VerticalBox {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: center;

            HorizontalBox {
                spacing: 6px;

                Text {
                    text: "[" + root.window.process_name + "]";
                    font-size: 11px;
                    font-weight: 700;
                    color: root.window.pinned ? Theme.accent-strong : Theme.text-primary;
                    vertical-alignment: center;
                }
                Text {
                    text: root.window.title;
                    font-size: 11px;
                    color: Theme.text-secondary;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.window.hwnd
                    + (root.window.topmost ? " · 系统已置顶" : "");
                font-size: 9.5px;
                color: Theme.text-muted;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        // 中栏·优先级步进器：96 × 28 固定列宽（未置顶时灰化禁用；行内垂直居中）
        Rectangle {
            width: 96px;
            height: parent.height;

            PriorityStepper {
                width: 96px;
                height: 28px;
                y: (parent.height - self.height) / 2;
                value: root.window.priority;
                enabled: root.window.pinned;
                changed(p) => { root.priority-changed(p); }
            }
        }

        // 右栏·置顶开关：44px 固定列宽；开关贴列右缘、垂直居中。
        Rectangle {
            width: 44px;
            height: parent.height;

            Switch {
                width: 40px;
                height: 20px;
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
                checked: root.window.pinned;
                toggled => {
                    root.pin-toggled(self.checked);
                }
            }
        }
    }
}

// —— 全局窗口置顶 · 管理弹窗（根层级 Overlay 5） ——
// 顶栏：标题 + 刷新按钮 + 关闭按钮；下方实时搜索过滤框；中部纯文本窗口列表
//（每行 = 优先级步进器 + 置顶开关）；操作即时联动（底层立即应用 / 解除置顶）。
// 输入 / 动画架构与其余弹窗一致：遮罩常驻渐变 + 卡片仅展示期挂载。
component TopmostModal inherits Rectangle {
    in property <bool> show;
    in property <[TopmostWindowItem]> windows;
    in-out property <string> search: "";
    callback close-requested;
    callback refresh-requested;
    callback search-changed(string);
    callback pin-toggled(string, bool);
    callback priority-changed(string, int);

    background: Theme.overlay-scrim;
    opacity: root.show ? 1.0 : 0.0;
    animate opacity { duration: 160ms; easing: ease-out; }

    backdrop := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        enabled: root.show;
        clicked => { root.close-requested(); }
        scroll-event(event) => { return accept; }
    }

    if root.show : dialog := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(470px, parent.width - 32px);
        height: min(540px, parent.height - 24px);
        border-radius: 14px;
        background: Theme.dialog-bg;
        border-width: 1px;
        border-color: Theme.dialog-border;
        clip: true;

        body-catcher := TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            clicked => { }
            scroll-event(event) => { return accept; }
        }

        VerticalBox {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 12px;

            // —— 顶栏：标题 + 刷新 + 关闭 ——
            HorizontalBox {
                spacing: 8px;

                Text {
                    text: "全局窗口置顶 - 管理窗口";
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.text-strong;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                GhostButton {
                    text: "刷新";
                    button-width: 64px;
                    height: 24px;
                    clicked => { root.refresh-requested(); }
                }
                GhostIconButton {
                    icon: @image-url("icons/close.svg");
                    icon-size: 13px;
                    icon-color: Theme.text-muted;
                    clicked => { root.close-requested(); }
                }
            }

            // —— 实时搜索过滤 ——
            LineEdit {
                placeholder-text: "搜索进程名 / 标题 / HWND…";
                font-size: 12px;
                text: root.search;
                edited(text) => {
                    root.search = text;
                    root.search-changed(text);
                }
            }

            // —— 语义提示 ——
            Text {
                text: "1 级最顶层 · 9 级最低；点击开关即时置顶 / 解除，优先级步进器即时调整链序。列表为纯文本渲染，不加载窗口图标。";
                font-size: 10.5px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }

            // —— 窗口列表 ——
            win-scroll := ScrollView {
                vertical-stretch: 1;

                VerticalBox {
                    padding-right: 8px; // 预留纵向滚动条悬浮带
                    padding-top: 2px;
                    padding-bottom: 2px;
                    spacing: 4px;
                    width: win-scroll.visible-width;

                    if root.windows.length == 0 : Rectangle {
                        height: 130px;

                        Text {
                            text: "没有匹配的窗口\n点击「刷新」重新枚举桌面顶层窗口";
                            font-size: 11px;
                            color: Theme.text-muted;
                            width: parent.width;
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    for win in root.windows : TopmostWindowRow {
                        window: win;
                        pin-toggled(checked) => {
                            root.pin-toggled(win.hwnd, checked);
                        }
                        priority-changed(p) => {
                            root.priority-changed(win.hwnd, p);
                        }
                    }
                }
            }
        }
    }
}

// —— 全局设置：日志与截图目录自定义（根层级 Overlay 3，v0.3.2） ——
//
// 展示三类目录（应用日志 / 终端交互日志 / 弹窗截图）的当前生效绝对路径，
// 每行提供「更改…」（Win32 原生文件夹选择，Rust 侧 SHBrowseForFolderW）、
// 「打开」（资源管理器）、「恢复默认」（配置置 None → 回退 exe 同级默认布局）。
// 三张路径卡片整体置于 ScrollView 内（v0.4.0 滚动截断修复）：弹窗默认高度
// 480px 完整展开；小屏幕 / 低分辨率下高度随窗口收缩，卡片总高超限时以
// 鼠标滚轮上下滑动浏览，第三张卡片不再被截断。
// 输入 / 动画架构与其余弹窗一致（遮罩常驻渐变 + 卡片仅展示期挂载）。
component SettingsModal inherits Rectangle {
    in property <bool> show;
    in property <string> app-log-dir: "";
    in property <string> terminal-log-dir: "";
    in property <string> screenshot-dir: "";
    callback close-requested;
    callback browse-key(string);
    callback open-key(string);
    callback reset-key(string);

    background: Theme.overlay-scrim;
    opacity: root.show ? 1.0 : 0.0;
    animate opacity { duration: 160ms; easing: ease-out; }

    backdrop := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        enabled: root.show;
        clicked => { root.close-requested(); }
        scroll-event(event) => { return accept; }
    }

    if root.show : dialog := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(464px, parent.width - 32px);
        // 高度自适应：默认 480px（三张路径卡片完整展开）；小屏幕 / 低分辨率下
        // 随窗口收缩（max-height 保留 40px 遮罩余量），配合下方 ScrollView 以
        // 鼠标滚轮滚动浏览全部卡片（v0.4.0 滚动截断修复）。
        preferred-height: 480px;
        max-height: parent.height - 40px;
        border-radius: 14px;
        background: Theme.dialog-bg;
        border-width: 1px;
        border-color: Theme.dialog-border;
        clip: true;

        body-catcher := TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            clicked => { }
            scroll-event(event) => { return accept; }
        }

        VerticalBox {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 12px;
            // 标题 / 提示固定在上部，剩余纵向空间由 ScrollView 吸收（stretch），
            // 卡片内容超高时滚动浏览、不高时自然撑满。

            // —— 标题行 ——
            HorizontalBox {
                spacing: 8px;

                Text {
                    text: "全局设置 - 日志与截图目录";
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.text-strong;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                GhostIconButton {
                    icon: @image-url("icons/close.svg");
                    icon-size: 13px;
                    icon-color: Theme.text-muted;
                    clicked => { root.close-requested(); }
                }
            }

            // —— 语义提示 ——
            Text {
                text: "自定义各类日志 / 截图的落盘目录；相对路径锚定可执行文件所在目录，绝对路径原样生效。";
                font-size: 11px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }

            // —— 三类目录行：ScrollView 纵向滚动（v0.4.0 修复：三张卡片总高
            //    超出弹窗约束时不再被截断，可滚轮上下滑动浏览全部） ——
            // 与 RulesModal 的 rules-scroll 同一滚动架构：ScrollView 自身
            // vertical-stretch: 1 吸收剩余高度；内层 VerticalBox 按
            // visible-width 取视口宽度、右侧预留滚动条悬浮带、卡片间距 10px。
            settings-scroll := ScrollView {
                vertical-stretch: 1;

                VerticalBox {
                    padding-right: 8px; // 预留纵向滚动条悬浮带
                    padding-top: 2px;
                    padding-bottom: 2px;
                    spacing: 10px;
                    width: settings-scroll.visible-width;

                    PathSettingRow {
                        title: "应用日志目录";
                        tip: "程序运行日志 + 用户操作审计";
                        path: root.app-log-dir;
                        key: "app_log";
                        browse-key(key) => { root.browse-key(key); }
                        open-key(key) => { root.open-key(key); }
                        reset-key(key) => { root.reset-key(key); }
                    }
                    PathSettingRow {
                        title: "终端交互日志目录";
                        tip: "PowerShell / bash / cmd 会话记录";
                        path: root.terminal-log-dir;
                        key: "terminal_log";
                        browse-key(key) => { root.browse-key(key); }
                        open-key(key) => { root.open-key(key); }
                        reset-key(key) => { root.reset-key(key); }
                    }
                    PathSettingRow {
                        title: "弹窗截图目录";
                        tip: "拦截留痕截图（PNG）";
                        path: root.screenshot-dir;
                        key: "popup_screenshot";
                        browse-key(key) => { root.browse-key(key); }
                        open-key(key) => { root.open-key(key); }
                        reset-key(key) => { root.reset-key(key); }
                    }
                }
            }
        }
    }
}

// —— 关于 TLToolBox：图标 / 版本 / 开源地址 / 检查更新（根层级 Overlay 4） ——
//
// 「检查更新」经 WinHttp 原生请求 GitHub Releases 接口（零网络库依赖）；
// 发现新版本时展示琥珀色下载入口（点击经系统浏览器打开 Releases 页面）。
component AboutModal inherits Rectangle {
    in property <bool> show;
    in property <string> version: "";
    in property <string> update-status: "";
    in property <bool> update-available: false;
    in property <string> latest-version: "";
    callback close-requested;
    callback open-repo-requested;
    callback check-update-requested;
    callback open-download-requested;

    background: Theme.overlay-scrim;
    opacity: root.show ? 1.0 : 0.0;
    animate opacity { duration: 160ms; easing: ease-out; }

    backdrop := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        enabled: root.show;
        clicked => { root.close-requested(); }
        scroll-event(event) => { return accept; }
    }

    if root.show : dialog := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(430px, parent.width - 32px);
        height: min(388px, parent.height - 48px);
        border-radius: 14px;
        background: Theme.dialog-bg;
        border-width: 1px;
        border-color: Theme.dialog-border;
        clip: true;

        body-catcher := TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            clicked => { }
            scroll-event(event) => { return accept; }
        }

        VerticalBox {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 12px;

            // —— 标题行 ——
            HorizontalBox {
                spacing: 8px;

                Text {
                    text: "关于 TLToolBox";
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.text-strong;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                GhostIconButton {
                    icon: @image-url("icons/close.svg");
                    icon-size: 13px;
                    icon-color: Theme.text-muted;
                    clicked => { root.close-requested(); }
                }
            }

            // —— 品牌区：图标 + 名称 + 版本 ——
            HorizontalBox {
                spacing: 12px;

                Rectangle {
                    width: 46px;
                    height: 46px;
                    border-radius: 12px;
                    background: Theme.pill-bg;
                    border-width: 1px;
                    border-color: Theme.pill-border;

                    Image {
                        source: @image-url("icons/shield.svg");
                        colorize: Theme.pill-text;
                        width: 26px;
                        height: 26px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
                VerticalBox {
                    spacing: 2px;
                    alignment: center;

                    Text {
                        text: "TLToolBox";
                        font-size: 17px;
                        font-weight: 700;
                        color: Theme.text-strong;
                    }
                    Text {
                        text: "版本 " + root.version;
                        font-size: 11px;
                        color: Theme.text-secondary;
                    }
                }
            }

            Text {
                text: "专注桌面常驻与开关控制的轻量级原生 Windows 工具箱：弹窗拦截 / 系统防休眠 / 剪贴板净化 / 终端交互日志 / 全局窗口置顶守护。";
                font-size: 11px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }

            // —— 开源地址（可点击，经 ShellExecuteW 打开浏览器） ——
            Text {
                text: "开源地址：";
                font-size: 11px;
                color: Theme.text-secondary;
            }
            link-row := Rectangle {
                height: 28px;
                border-radius: 7px;
                background: transparent;

                states [
                    hover when link-touch.has-hover : {
                        background: Theme.link-bg-hover;
                    }
                ]
                animate background { duration: 90ms; }

                Text {
                    text: "https://github.com/ltl0312/TLToolBox.git";
                    font-size: 10.5px;
                    color: Theme.link-text;
                    overflow: elide;
                    x: 10px;
                    y: 0;
                    width: parent.width - 20px;
                    height: parent.height;
                    vertical-alignment: center;
                }
                link-touch := TouchArea {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.open-repo-requested(); }
                }
            }

            // —— 检查更新：按钮 + 状态文本 ——
            HorizontalBox {
                spacing: 10px;
                alignment: center;

                GhostButton {
                    text: "检查更新";
                    button-width: 88px;
                    clicked => { root.check-update-requested(); }
                }
                Text {
                    text: root.update-status;
                    font-size: 10.5px;
                    color: Theme.text-muted;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
            }

            // —— 下载入口（仅发现新版本时渲染，琥珀强调） ——
            if root.update-available : download-row := Rectangle {
                height: 32px;
                border-radius: 8px;
                background: Theme.update-badge-bg;
                border-width: 1px;
                border-color: Theme.update-badge-border;

                states [
                    hover when download-touch.has-hover && !download-touch.pressed : {
                        background: #fbbf2438;
                    }
                    pressed when download-touch.pressed : {
                        background: #fbbf2452;
                    }
                ]
                animate background { duration: 100ms; }

                Text {
                    text: "发现新版本 " + root.latest-version + " —— 点击前往 GitHub 下载";
                    font-size: 11.5px;
                    font-weight: 700;
                    color: Theme.update-badge-text;
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
                download-touch := TouchArea {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.open-download-requested(); }
                }
            }
        }
    }
}

// —— Toast 轻量操作反馈：窗口底部居中的半透明悬浮胶囊 ——
//
// 输入架构（沿用 RulesModal 的「常驻挂载 + 状态驱动」思路，规避隐藏层拦截交互）：
//   - 组件根铺满窗口但完全透明、不含任何 TouchArea —— 纯定位容器，鼠标事件天然穿透；
//   - 真正可视的胶囊仅在自身区域内放置 TouchArea，且 `enabled: root.show`
//     （Slint 语义：disabled 的 TouchArea 把事件穿透给下层元素），因此 Toast 隐藏时
//     绝不在窗口底部形成点击 / 滚轮黑洞；
//   - 展示与收回均走 150ms 过渡：opacity 淡入淡出 + y 轴 8px 轻微位移（入场轻微上浮、
//     离场轻微下沉），动画只作用于胶囊本体，透明定位层无感知；
//   - 点击胶囊本体 → 上抛 dismissed，由装配点（MainWindow）复位 show_toast 提前关闭；
//     2.5s 自动收回由 Rust 侧 Tokio 延迟任务驱动（复位同一属性，对已隐藏态幂等）。
component Toast inherits Rectangle {
    in property <string> message: "";
    in property <bool> show: false;
    callback dismissed;

    background: transparent;

    capsule := Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 24px + (root.show ? 0px : 8px);
        width: 200px;
        height: 34px;
        border-radius: 17px;
        background: Theme.toast-bg;
        border-width: 1px;
        border-color: Theme.toast-border;
        opacity: root.show ? 1.0 : 0.0;
        animate opacity, y { duration: 150ms; easing: ease-out; }

        Text {
            text: root.message;
            font-size: 12px;
            font-weight: 500;
            color: Theme.toast-text;
            overflow: elide;
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        toast-touch := TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            enabled: root.show;
            clicked => { root.dismissed(); }
        }
    }
}

export component MainWindow inherits Window {
    title: "TLToolBox - 桌面实用工具箱";
    width: 480px;
    height: 560px;
    background: Theme.window-bg;
    // 界面文案为中英混排（模块名 / 描述含中文），统一使用覆盖 CJK 的 UI 字体；
    // 若偏好在纯西文环境还原原生观感，可改回 "Segoe UI"。
    default-font-family: "Microsoft YaHei UI";

    // ===== 对外暴露的只读数据（由 Rust 装配层注入） =====
    in property <[ModuleItem]> modules;
    in property <[string]> popup_rules;
    in property <bool> show_rules_modal: false;
    // 弹窗拦截留痕（截图列表 / 预览图 / 预览信息）。
    in property <[CaptureItem]> captures;
    in property <image> capture_preview;
    in property <string> capture_preview_caption: "";
    // 终端交互日志 · 存储管理弹窗：当前生效的日志根目录绝对路径（展示文本）与显隐开关。
    in property <string> terminal_log_dir_display: "";
    in property <bool> show_terminal_modal: false;
    // 全局设置（日志 / 截图目录自定义，v0.3.2）：显隐开关 + 三类目录当前生效路径。
    in property <bool> show_settings_modal: false;
    in property <string> app_log_dir_display: "";
    in property <string> screenshot_dir_display: "";
    // 全局窗口置顶管理弹窗（v0.4.0）：显隐开关 + 候选窗口列表 + 实时搜索文本。
    in property <bool> show_topmost_modal: false;
    in property <[TopmostWindowItem]> topmost_windows;
    in-out property <string> topmost_search: "";
    // 关于弹窗（v0.3.2）：显隐开关、更新状态文本 / 下载入口。
    in property <bool> show_about_modal: false;
    in property <string> update_status: "";
    in property <bool> update_available: false;
    in property <string> latest_version: "";
    in property <bool> autostart_enabled;
    // 提权（管理员）状态：true → 标题旁「管理员 (Admin)」翡翠徽标；false → 盾牌提权按钮。
    in property <bool> elevated: false;
    // 界面小版本号：**不写死任何版本字面量**，由 Rust 装配层在初始化时经
    // env!("CARGO_PKG_VERSION") 动态注入（见 crate::main 的 set_app_version）。
    in property <string> app-version: "";

    // ===== Toast 轻量操作反馈（Rust 侧经统一 show_toast 驱动；UI 点击胶囊可提前关闭） =====
    in-out property <string> toast_message: "";
    in-out property <bool> show_toast: false;
    callback trigger_toast(string);

    // ===== 对外回调（由 Rust 装配层实现） =====
    callback toggle_module(string, bool);
    callback toggle_autostart(bool);
    callback toggle_all_modules(bool);
    callback request_elevate();
    callback open_module_settings(string);
    callback open_terminal_modal();
    callback close_terminal_modal();
    callback open_log_dir_in_explorer();
    callback close_rules_modal();
    callback add_rule(string);
    callback remove_rule(int);
    callback capture_selected(int);
    callback open_capture_dir();
    // 关于弹窗 / 检查更新（v0.3.2）。
    callback open_about_modal();
    callback close_about_modal();
    callback open_repo_url();
    callback check_for_updates();
    callback open_download_url();
    // 全局设置（目录自定义，v0.3.2）。
    callback open_settings_modal();
    callback close_settings_modal();
    callback browse_setting_dir(string);
    callback open_setting_dir(string);
    callback reset_setting_dir(string);
    // 全局窗口置顶（v0.4.0）。
    callback open_topmost_modal();
    callback close_topmost_modal();
    callback refresh_topmost();
    callback topmost_search_changed(string);
    callback topmost_toggle_pin(string, bool);
    callback topmost_set_priority(string, int);

    // ============================================================
    //  顶部系统与全局控制栏 + 单栏模块卡片流
    // ============================================================
    VerticalBox {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 18px;
        padding-bottom: 14px;
        spacing: 12px;

        // ─── 行 1：品牌标题 / 小版本号 / 提权状态指示 / 一键全开全关 ───
        // 行内元素高度由行自然高度决定（默认交叉轴拉伸填充）；
        // 固定尺寸的小元素以 y 公式垂直居中，撑满行的文本用垂直居中排字。
        HorizontalBox {
            spacing: 10px;

            Text {
                text: "TLToolBox";
                font-size: 19px;
                font-weight: 700;
                color: Theme.text-strong;
                min-height: 26px;
                vertical-alignment: center;
            }

            // 小版本号徽标（固定 20px 高，y 公式垂直居中）。提权形态下让位给
            // 「管理员 (Admin)」徽标（版本号仍可从 About / exe 属性查得）。
            if !root.elevated : Rectangle {
                width: 66px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                border-radius: 10px;
                background: Theme.pill-bg;
                border-width: 1px;
                border-color: Theme.pill-border;

                Text {
                    text: "v" + root.app-version;
                    font-size: 10.5px;
                    font-weight: 600;
                    color: Theme.pill-text;
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // —— 提权状态指示 / 提权入口（UIPI 突围，与托盘菜单联动） ——
            // 未提权：渲染琥珀盾牌按钮（醒目提权入口：点击 → UAC 确认 → 以管理员
            //         身份重启，突破「向高权限窗口投递 WM_CLOSE 被静默丢弃」限制）；
            // 已提权：渲染翡翠「管理员 (Admin)」徽标并隐藏入口——已提权的实例
            //         不需要也无意义再自我提权。
            if !root.elevated : ElevateButton {
                clicked => { root.request_elevate(); }
            }
            if root.elevated : AdminBadge { }

            Rectangle { horizontal-stretch: 1; }

            GhostButton {
                text: "全部停用";
                clicked => { root.toggle_all_modules(false); }
            }
            GhostButton {
                text: "全部启用";
                clicked => { root.toggle_all_modules(true); }
            }
        }

        // ─── 行 2：副标题 + 关于 / 设置 + 全局开机自启开关 ───
        HorizontalBox {
            spacing: 8px;

            Text {
                text: "原生 Windows 轻量工具箱 · 桌面常驻";
                font-size: 11px;
                color: Theme.text-muted;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            // 「关于」：版本 / 开源地址 / 检查更新弹窗入口（v0.3.2）。
            GhostButton {
                text: "关于";
                button-width: 56px;
                clicked => { root.open_about_modal(); }
            }
            // 「设置」：日志与截图目录自定义弹窗入口（v0.3.2）。
            GhostButton {
                text: "设置";
                button-width: 56px;
                clicked => { root.open_settings_modal(); }
            }

            Text {
                text: "开机自启";
                font-size: 12px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
            Switch {
                checked: root.autostart_enabled;
                toggled => {
                    root.toggle_autostart(self.checked);
                }
            }
        }

        // 分隔线：控制栏与卡片区之间的层级边界
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }

        // ─── 核心功能卡片区：ScrollView 流式滚动列表 ───
        module-scroll := ScrollView {
            vertical-stretch: 1;

            VerticalBox {
                padding-right: 8px; // 预留纵向滚动条悬浮带
                padding-bottom: 4px;
                spacing: 10px;
                width: module-scroll.visible-width; // 卡片宽度钉住视口，滚动条不横向挤压内容

                for item in modules: ModuleCard {
                    module: item;
                    toggled(checked) => {
                        root.toggle_module(item.id, checked);
                    }
                    settings-clicked => {
                        root.open_module_settings(item.id);
                    }
                }
            }
        }
    }

    // ============================================================
    //  根层级规则管理遮罩层（覆盖于全部内容之上；见 RulesModal 输入架构说明）
    // ============================================================
    rules-modal := RulesModal {
        width: root.width;
        height: root.height;
        show: root.show_rules_modal;
        rules: root.popup_rules;
        captures: root.captures;
        capture-preview: root.capture_preview;
        capture-preview-caption: root.capture_preview_caption;

        close-requested => { root.close_rules_modal(); }
        add-requested(keyword) => { root.add_rule(keyword); }
        remove-requested(index) => { root.remove_rule(index); }
        capture-selected(index) => { root.capture_selected(index); }
        open-capture-dir => { root.open_capture_dir(); }
        browse-capture-dir => { root.browse_setting_dir("popup_screenshot"); }
    }

    // ============================================================
    //  根层级「终端日志记录 - 存储管理」遮罩层（模块设置弹窗之二；声明于规则遮罩
    //  之后、Tool 之前——各弹窗互斥展示，Toast 仍保持全局最高层级）
    // ============================================================
    terminal-modal := TerminalSettingsModal {
        width: root.width;
        height: root.height;
        show: root.show_terminal_modal;
        log-dir: root.terminal_log_dir_display;

        close-requested => { root.close_terminal_modal(); }
        open-log-dir-requested => { root.open_log_dir_in_explorer(); }
        browse-dir-requested => { root.browse_setting_dir("terminal_log"); }
        reset-dir-requested => { root.reset_setting_dir("terminal_log"); }
    }

    // ============================================================
    //  根层级「全局设置 - 日志与截图目录」遮罩层（v0.3.2）
    // ============================================================
    settings-modal := SettingsModal {
        width: root.width;
        height: root.height;
        show: root.show_settings_modal;
        app-log-dir: root.app_log_dir_display;
        terminal-log-dir: root.terminal_log_dir_display;
        screenshot-dir: root.screenshot_dir_display;

        close-requested => { root.close_settings_modal(); }
        browse-key(key) => { root.browse_setting_dir(key); }
        open-key(key) => { root.open_setting_dir(key); }
        reset-key(key) => { root.reset_setting_dir(key); }
    }

    // ============================================================
    //  根层级「全局窗口置顶 - 管理窗口」遮罩层（v0.4.0）
    // ============================================================
    topmost-modal := TopmostModal {
        width: root.width;
        height: root.height;
        show: root.show_topmost_modal;
        windows: root.topmost_windows;
        search: root.topmost_search;

        close-requested => { root.close_topmost_modal(); }
        refresh-requested => { root.refresh_topmost(); }
        search-changed(text) => { root.topmost_search_changed(text); }
        pin-toggled(hwnd, checked) => { root.topmost_toggle_pin(hwnd, checked); }
        priority-changed(hwnd, priority) => { root.topmost_set_priority(hwnd, priority); }
    }

    // ============================================================
    //  根层级「关于 TLToolBox」遮罩层（v0.3.2：版本 / 开源地址 / 检查更新）
    // ============================================================
    about-modal := AboutModal {
        width: root.width;
        height: root.height;
        show: root.show_about_modal;
        version: root.app-version;
        update-status: root.update_status;
        update-available: root.update_available;
        latest-version: root.latest_version;

        close-requested => { root.close_about_modal(); }
        open-repo-requested => { root.open_repo_url(); }
        check-update-requested => { root.check_for_updates(); }
        open-download-requested => { root.open_download_url(); }
    }

    // ============================================================
    //  根层级 Toast 悬浮胶囊（声明在规则遮罩之后 → 层级最高：即使弹窗开着，
    //  操作反馈也始终浮在最上层，不被遮罩 / 弹窗卡片遮挡）
    // ============================================================
    toast := Toast {
        width: root.width;
        height: root.height;
        message: root.toast_message;
        show: root.show_toast;

        // 点击胶囊本体 → 提前关闭（复位显隐；Rust 侧定时收回对已隐藏态幂等）。
        dismissed => { root.show_toast = false; }
    }
}
